---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import AuthorChip from '../../components/AuthorChip.astro';
import Reveal from '../../components/Reveal.astro';
import Words from '../../components/Words.astro';
import { getPosts, getAuthor, CATEGORIES, formatDate, readingMinutes, type Post } from '../../lib/blog';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id).slice(0, 3) } }));
}

interface Props { post: Post; others: Post[] }
const { post, others } = Astro.props;
const { title, description, date, category, cover, coverAlt, author } = post.data;
const { Content, headings } = await render(post);

// Table of contents: the post's top-level section headings, skipping a leading one that repeats the title.
const tocHeadings = headings
  .filter((h) => h.depth <= 4)
  .filter((h, i) => !(i === 0 && h.text.trim().toLowerCase() === title.trim().toLowerCase()));
const tocDepth = Math.min(...tocHeadings.map((h) => h.depth));
const toc = tocHeadings.filter((h) => h.depth === tocDepth);

const url = new URL(u(`/blog/${post.id}`), Astro.site).href;
const og = await getImage({ src: cover, width: 1200, format: 'jpg' });
const a = getAuthor(author);
const iso = date.toISOString().slice(0, 10);
const enc = encodeURIComponent;
import { u } from '../../lib/url';
---
<Base
  title={`${title} | ReFi Hub`}
  description={description}
  image={og.src}
  type="article"
  bodyClass="blog"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: iso,
    image: new URL(og.src, Astro.site).href,
    url,
    articleSection: CATEGORIES[category],
    author: { '@type': 'Person', name: a.name, jobTitle: a.role },
    publisher: { '@type': 'Organization', name: 'ReFi Hub', url: Astro.site?.href },
  }}
>
<Fragment slot="head">
  <meta property="article:published_time" content={iso}>
  <meta property="article:section" content={CATEGORIES[category]}>
</Fragment>
<main>
  <article>
    <header class="ahero">
      <div class="bwrap">
        <div class="head">
          <div class="meta" data-reveal>
            <a class="pill" href={u(`/blog?c=${category}`)} style="text-decoration:none;color:inherit">{CATEGORIES[category]}</a>
            <span aria-hidden="true">•</span>
            <time datetime={iso}>{formatDate(date)}</time>
            <span aria-hidden="true">•</span>
            <span>{readingMinutes(post.body ?? '')} min read</span>
          </div>
          <Words class="d1" text={title} />
          <p class="lead" data-reveal style="--i:3">{description}</p>
          <div data-reveal style="--i:4"><AuthorChip id={author} /></div>
        </div>
        <div data-reveal>
          <Image class="cover" src={cover} alt={coverAlt === title ? '' : coverAlt} widths={[720, 1360, 2040]} sizes="(max-width:1440px) 100vw, 1360px" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </header>

    <div class="aband">
      <div class="bwrap">
        <aside class="aside">
          {toc.length > 1 && (
            <nav class="box toc" aria-label="Table of contents">
              <span class="lbl">Table of contents</span>
              <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </nav>
          )}
          <div class="box share">
            <span>Share</span>
            <div>
              <a href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(title)}`} target="_blank" rel="noopener" aria-label="Share on X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`} target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg></a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a>
            </div>
          </div>
        </aside>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <section class="more-sec">
    <div class="bwrap">
      <div class="head" data-reveal>
        <h2>Looking for more? Dive into our other articles, updates, and strategies</h2>
        <a class="btn-black" href={u('/blog')}>Browse all articles <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <div class="pgrid">{others.map((p, i) => <PostCard post={p} index={i} />)}</div>
    </div>
  </section>
</main>
<Reveal />
<script>
  // Highlight the table-of-contents entry for the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const onScroll = () => {
      let current = targets[0];
      for (const t of targets) if (t.getBoundingClientRect().top < 140) current = t;
      links.forEach((a) => a.setAttribute('aria-current', String(a.hash.slice(1) === current.id)));
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
</Base>
