---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Reveal from '../components/Reveal.astro';
import { getPosts } from '../lib/blog';
import '../styles/landing.css';
import '../styles/blog.css';

const latest = (await getPosts()).slice(0, 4);
---
<Base title="ReFi Hub — on-chain energy assets" description="Operating solar and EV charging in Singapore, Brazil and India, distributing USDC from real electricity sales. Stake SOL with refiSOL." home>
<Fragment slot="before-nav">
<div class="strip"><div class="wrap">
  <span>TEAM REVIEW</span>
  <span><span class="prov" data-p="real">real</span>live on app.refihub.io today</span>
  <span><span class="prov" data-p="verify">verify</span>from your brief or internal notes</span>
  <span><span class="prov" data-p="mock">mock</span>invented for the prototype</span>
</div></div>
</Fragment>

<script type="application/json" id="DATA" is:inline>
{
  "stats":[
