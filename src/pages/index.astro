---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
import { getPosts, CATEGORIES, formatDate } from '../lib/blog';
import { u } from '../lib/url';
import '../styles/landing.css';
import '../styles/blog.css';

const latest = (await getPosts()).slice(0, 4);
const [featured, ...more] = latest;
const pics = Object.fromEntries(['flp2', 'flp', 'surya', 'vox', 'crn', 'exodos'].map((id) => [id, u(`/assets/${id}.jpg`)]));

/* All landing-page figures live here. p = provenance: real, verify or mock (see README). */
const DATA = {
  staked: { v: '190.8', u: 'K SOL', label: 'Staked with our validator', src: 'Stakewiz, 22 Oct 2026', p: 'real' },
  /* paid and payments: every repayment listed on app.refihub.io/investments/4..9, summed on 22 Oct 2026 */
  stats: [
    { v: 27, label: 'Energy assets operating', sub: 'Solar plants and EV chargers in three countries', p: 'verify' },
    { v: 14, prefix: '+', suffix: '%', label: 'Realized IRR', sub: 'On payments made, not forecasts', p: 'verify' },
    { v: 65, label: 'Payments made', sub: 'Across all six assets, since October 2024', p: 'real' },
    { v: 52.7, prefix: '$', unit: 'K', label: 'Paid to investors', sub: 'In USDC, from energy sales', p: 'real' },
    { v: 481, unit: 'MWh', label: 'Clean energy produced', sub: 'Metered at each asset', p: 'verify' },
  ],
  assets: [
    { id: 'flp2', name: 'FLP II', operator: 'PivotGreen', place: 'Singapore', lat: 1.29, lon: 103.85,
      type: 'Rooftop solar', kind: 'solar', kw: 111.69, yield: 21.42, raised: 100000, status: 'distributing',
      payments: 7, last: 'Oct 2026', lastAmt: 1793.75, term: 'Pays until 2035', inv: 9,
      note: 'Second raise on an operating rooftop plant in Singapore. About $1,780 a month since April 2026.' },
    { id: 'flp', name: 'FLP', operator: 'PivotGreen', place: 'Singapore', lat: 1.29, lon: 103.85,
      type: 'Rooftop solar', kind: 'solar', kw: 66.9, yield: 14.03, raised: 59000, status: 'distributing',
      payments: 12, last: 'Oct 2026', lastAmt: 702.23, term: 'Pays until 2049', inv: 8,
      note: 'Rooftop solar in Singapore, contracted to pay until 2049. Every payment on schedule.' },
    { id: 'surya', name: 'Surya', operator: 'DeCharge', place: 'India', lat: 26.85, lon: 80.95,
      type: 'EV charging', kind: 'ev', kw: 345, yield: 12.27, raised: 149999.99, status: 'distributing',
      payments: 8, last: 'Sep 2026', lastAmt: 1071.38, term: 'Pays until 2028', inv: 7,
      note: '19 fast chargers on Indian highways. Paid per use, so payouts move with traffic. July 2026 was paid inside August after a billing change.' },
    { id: 'vox', name: 'EV Charging Stations', operator: 'VOX', place: 'Rio de Janeiro, Brazil', lat: -22.91, lon: -43.17,
      type: 'EV charging', kind: 'ev', kw: 112, yield: 9.3, raised: 49999.2, status: 'maintenance',
      payments: 7, last: 'Apr 2026', lastAmt: 354.73, term: 'Pays until 2030', inv: 6,
      note: 'Four fast chargers in Rio. Our weakest asset. No payment since April 2026.' },
    { id: 'crn', name: 'CRN', operator: 'Tab Energia', place: 'Brazil', lat: -19.9, lon: -43.94,
      type: 'Ground-mounted solar', kind: 'solar', kw: 143.2, yield: 11.29, raised: 100000, status: 'maintenance',
      payments: 8, last: 'Mar 2026', lastAmt: 941.0, term: 'Pays until 2055', inv: 5,
      note: 'Paid $941 a month until March 2026, then stopped while its power contract moved to GEDISA. The transfer closed on 27 April. Payments are pending.' },
    { id: 'exodos', name: 'Exodos 1', operator: 'IPE Assets', place: 'Brazil', lat: -23.55, lon: -46.63,
      type: 'Solar', kind: 'solar', kw: 50.8, yield: 14.53, raised: 32499.93, status: 'distributing',
      payments: 23, last: 'Sep 2026', lastAmt: 273.0, term: 'Pays until 2048', inv: 4,
      note: "Brazil's first tokenized solar plant. 23 payments since October 2024. April 2026 was paid late, in May." },
  ],
  validator: [
    { v: '190.8', u: 'K SOL', l: 'Staked', p: 'real' },
    { v: '99.95', u: '%', l: 'Uptime, 12 months', p: 'real' },
    { v: '0', u: '%', l: 'Skip rate', p: 'real' },
    { v: '30', u: '%', l: 'Fees to impact', p: 'real' },
  ],
  community: { v: '1,500', p: 'verify' },
};

const statText = (s: (typeof DATA.stats)[number]) => (s.prefix ?? '') + s.v.toLocaleString('en-US') + (s.suffix ?? '');
---
<Base title="ReFi Hub · Solar and EV charging, paid in USDC" description="We finance operating solar and EV charging in Brazil, India and Singapore. Their power sales pay investors in USDC. Stake SOL with us and part of our fees funds the next ones." home>
<Fragment slot="before-nav">
<div class="strip"><div class="wrap">
  <span>TEAM REVIEW</span>
  <span><span class="prov" data-p="real">real</span>live on app.refihub.io today</span>
  <span><span class="prov" data-p="verify">verify</span>from your brief or internal notes</span>
  <span><span class="prov" data-p="mock">mock</span>invented for the prototype</span>
</div></div>
</Fragment>

<script type="application/json" id="DATA" is:inline set:html={JSON.stringify({ assets: DATA.assets })} />
<script type="application/json" id="PICS" is:inline set:html={JSON.stringify(pics)} />

<main id="top">

<section class="hero on-photo">
  <div class="bg" style={`background-image:url(${u('/hero-solar.jpg')})`} role="img" aria-label="Sunlight across a solar panel array"></div>
  <div class="veil"></div>
  <div class="wrap"><div class="hero-in">
    <h1 class="display">We turn clean energy into USDC.</h1>
    <p class="lede">We finance operating energy assets in Brazil, India and Singapore. Their energy sales pay investors. Stake SOL with us and part of our fees funds the next ones.</p>
    <div class="btns">
      <a class="btn btn-primary" href="#record">Check the numbers</a>
    </div>
  </div></div>
</section>

<section class="sec record has-art" id="record">
  <canvas class="bg-art" data-energy="sweep" data-seed="4" aria-hidden="true"></canvas>
  <div class="wrap split r48">
    <div>
      <div class="sec-head">
        <h2 class="h2">Impact investing on Solana DeFi.</h2>
        <p class="lede">We finance energy assets that already run. When they sell energy, investors get paid.</p>
      </div>
      <div class="lead-num">
        <span class="label">{DATA.staked.label}<span class="prov" data-p={DATA.staked.p}>{DATA.staked.p}</span></span>
        <span class="num l">{DATA.staked.v}<span class="u">{DATA.staked.u}</span></span>
        <span class="src"><a href="https://stakewiz.com/validator/ReFiSbuMcV8PMYcpvm9RmHDhF9HR3qyxsHZgf359NUx" target="_blank" rel="noopener">{DATA.staked.src}</a></span>
      </div>
    </div>
    <div>
      <div class="meters five" id="meters">
        {DATA.stats.map((s) => (
          <div class="meter">
            <span class="label">{s.label}<span class="prov" data-p={s.p}>{s.p}</span></span>
            <span class="num m" data-to={s.v} data-pre={s.prefix ?? ''} data-suf={s.suffix ?? ''}><span class="n">{statText(s)}</span>{s.unit && <span class="u">{s.unit}</span>}</span>
            <span class="sub">{s.sub}</span>
          </div>
        ))}
      </div>
      <p class="notice">Payments follow real use, so they are uneven. Two assets are behind: CRN is waiting on a contract transfer, and VOX has not paid since April.</p>
    </div>
  </div>
</section>

<section class="sec band-sand mapsec" id="map"><div class="wrap">
  <div class="sec-head">
    <h2 class="h2">Six assets. Three countries.</h2>
    <p class="lede">Click an asset to see what it raised, what it has paid, and where it stands.</p>
  </div>
  <div class="mapwrap">
    <div>
      <div class="plate"><div class="stage" id="stage"><canvas id="cv"></canvas></div></div>
      <div class="legend">
        <span class="label"><i></i>Solar</span>
        <span class="label"><i class="sq"></i>EV charging</span>
        <span class="label"><i class="am"></i>Behind on payments</span>
        <span class="label">Markers grouped by country</span>
      </div>
    </div>
    <aside class="panel" id="panel" aria-live="polite"></aside>
  </div>
  <div class="ops">
    <span class="label">Run by our operating partners</span>
    <div class="ops-logos">
      <button type="button" class="h-pg" data-a="flp2" aria-pressed="false" aria-label="PivotGreen, Singapore"><img src={u('/logos/pivotgreen.svg')} alt="PivotGreen"></button>
      <button type="button" class="h-dc" data-a="surya" aria-pressed="false" aria-label="DeCharge, India"><img src={u('/logos/decharge.svg')} alt="DeCharge"></button>
      <button type="button" class="h-ipe" data-a="exodos" aria-pressed="false" aria-label="IPE Assets, Brazil"><img src={u('/logos/ipe-assets.svg')} alt="IPE Assets"></button>
      <button type="button" class="h-tab" data-a="crn" aria-pressed="false" aria-label="Tab Energia, Brazil"><img src={u('/logos/tab-energia.svg')} alt="Tab Energia"></button>
      <button type="button" class="h-vox" data-a="vox" aria-pressed="false" aria-label="VOX, Rio de Janeiro"><img src={u('/logos/vox.svg')} alt="VOX"></button>
    </div>
  </div>
</div></section>

<section class="sec band-ink sol has-art" id="refisol">
  <canvas class="bg-art" data-energy="sun" data-dark data-seed="8" aria-hidden="true"></canvas>
  <div class="wrap split">
    <div>
      <h2 class="h2">Stake SOL. Fund coral reefs.</h2>
      <p class="say">refiSOL is the <b>liquid staking token from our validator</b>. 30% of our fees fund coral reefs and clean energy.<span class="prov" data-p="verify">verify</span></p>
      <div class="btns">
        <a class="btn btn-stake" href="https://mkdir-numa.github.io/reeefisol/" target="_blank" rel="noopener">Stake SOL</a>
        <a class="btn btn-ghost" href="https://mkdir-numa.github.io/reeefisol/#faq-fees" target="_blank" rel="noopener">Fees and risks</a>
      </div>
    </div>
    <div class="sol-right">
      <div class="meters">
        {DATA.validator.map((m) => (
          <div class="meter"><span class="label">{m.l}<span class="prov" data-p={m.p}>{m.p}</span></span><span class="num m">{m.v}<span class="u">{m.u}</span></span></div>
        ))}
      </div>
      <p class="fine">Data: staked SOL from Stakewiz, 22 Oct 2026; the rest from <a href="https://stakewiz.com/validator/ReFiSbuMcV8PMYcpvm9RmHDhF9HR3qyxsHZgf359NUx" target="_blank" rel="noopener">Stakewiz</a> and <a href="https://www.validators.app/validators/ReFiqMfGnc7tW8WQtFFcJRPZSDAWDBnAsdoFYF2QnfR?locale=en&amp;network=mainnet" target="_blank" rel="noopener">validators.app</a>, 13 Oct 2026. Rewards vary. Downtime never touches your principal. refiSOL can trade below its SOL value.</p>
    </div>
  </div>
</section>

<section class="sec reports-home" id="reports"><div class="wrap">
  <div class="sec-head row">
    <div>
      <h2 class="h2">Every asset, reported on.</h2>
      <p class="lede">Monthly operating and payment reports from each asset, and how we pick them.</p>
    </div>
    <a class="lnk" href={u('/blog')}>All reports →</a>
  </div>
  <div class="feat">
    <a class="feat-card" href={u(`/blog/${featured.id}`)}>
      <Image src={featured.data.cover} alt={featured.data.coverAlt === featured.data.title ? '' : featured.data.coverAlt} widths={[480, 720, 960]} sizes="(max-width:860px) 100vw, 680px" />
      <span class="meta"><time class="label" datetime={featured.data.date.toISOString().slice(0, 10)}>{formatDate(featured.data.date)}</time><span class="badge solar">{CATEGORIES[featured.data.category]}</span></span>
      <span class="h3">{featured.data.title}</span>
    </a>
    <div class="feat-list">
      {more.map((post) => (
        <a href={u(`/blog/${post.id}`)}>
          <span class="label"><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time> · {CATEGORIES[post.data.category]}</span>
          <span class="h4">{post.data.title}</span>
        </a>
      ))}
    </div>
  </div>
</div></section>

<section class="sec band-sand proof" id="proof"><div class="wrap">
  <div class="sec-head">
    <h2 class="h2">Building on Solana since 2021.</h2>
    <p class="lede">Our app, docs and audit are public.</p>
  </div>
  <div class="rows">
    <div class="row-item"><h3 class="h3">Solana Foundation</h3><p>Backer <span class="prov" data-p="verify">verify</span></p><span></span></div>
    <div class="row-item"><h3 class="h3"><a href="https://superteamuk.org/" target="_blank" rel="noopener">Superteam UK</a> and <a href="https://superteam.ca/" target="_blank" rel="noopener">Superteam Canada</a></h3><p>Incubator and ecosystem partners <span class="prov" data-p="verify">verify</span></p><span></span></div>
    <div class="row-item"><h3 class="h3">Our own validator</h3><p>refiSOL, live on Solana <span class="prov" data-p="verify">link to vote account</span></p><span></span></div>
    <div class="row-item"><h3 class="h3">Over {DATA.community.v} members</h3><p>Investors, holders and members of <a href="https://www.coraltribe.io/" target="_blank" rel="noopener">Coral Tribe</a> (our sister company) <span class="prov" data-p={DATA.community.p}>{DATA.community.p}</span></p><span></span></div>
  </div>
  <div class="cards">
    <a class="card" href="https://app.refihub.io/energy-assets/" target="_blank" rel="noopener"><h3 class="h3">The app</h3><p>Asset pages, monthly reports and every distribution.</p><span class="lnk">app.refihub.io →</span></a>
    <a class="card" href="https://refihub.gitbook.io/refi-hub/how-refi-hub-works/where-returns-come-from" target="_blank" rel="noopener"><h3 class="h3">Documentation</h3><p>Where returns come from, how we pick assets, and the risks.</p><span class="lnk">refihub.gitbook.io →</span></a>
    <a class="card" href="#proof"><h3 class="h3">Smart-contract audit</h3><p>Independent audit by Solidproof.</p><span class="lnk">Solidproof <span class="prov" data-p="verify">link</span></span></a>
  </div>
</div></section>

</main>

<script is:inline>
(function(){
"use strict";
var D = JSON.parse(document.getElementById('DATA').textContent);
var PICS = JSON.parse(document.getElementById('PICS').textContent);
var $ = function(s,r){ return (r||document).querySelector(s); };
var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
function prov(p){ return p ? '<span class="prov" data-p="'+p+'">'+p+'</span>' : ''; }
function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
function money(n){ return '$'+Number(n).toLocaleString('en-US',{maximumFractionDigits:0}); }

/* data-status toggle */
var pv = $('#pvBtn');
pv.addEventListener('click', function(){
  var on = document.body.classList.toggle('prov-on');
  pv.setAttribute('aria-pressed', on ? 'true' : 'false');
});

/* ---------- meter count-up: the numbers are already on the page; they count up once when first seen ---------- */
function countUp(el){
  var n = el.querySelector('.n');
  var to = parseFloat(el.dataset.to), pre = el.dataset.pre, suf = el.dataset.suf;
  var dec = (to % 1 !== 0) ? 1 : 0, t0 = performance.now(), dur = 900;
  function step(now){
    var k = Math.min(1, (now - t0) / dur), eased = 1 - Math.pow(1 - k, 3), cur = to * eased;
    n.textContent = pre + (dec ? cur.toFixed(dec) : Math.round(cur).toLocaleString('en-US')) + suf;
    if(k < 1) requestAnimationFrame(step);
    else n.textContent = pre + (dec ? to.toFixed(dec) : to.toLocaleString('en-US')) + suf;
  }
  requestAnimationFrame(step);
}
if(!reduced && 'IntersectionObserver' in window){
  var mio = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting) return;
      mio.unobserve(e.target);
      Array.prototype.forEach.call(e.target.querySelectorAll('[data-to]'), countUp);
    });
  }, {threshold:.4});
  mio.observe($('#meters'));
}

/* ---------- world map ---------- */
var LON0 = -110, LON1 = 150, LAT0 = -50, LAT1 = 62;
var LAND = [
 [[-168,66],[-160,71],[-140,70],[-125,70],[-110,68],[-95,69],[-82,73],[-70,68],[-64,60],[-55,52],[-62,47],[-67,45],[-70,42],[-74,39],[-78,34],[-81,28],[-80,25],[-84,22],[-88,21],[-91,17],[-84,10],[-78,8],[-83,14],[-94,16],[-97,25],[-105,21],[-112,26],[-117,33],[-122,38],[-124,45],[-124,49],[-131,54],[-141,60],[-152,59],[-163,59]],
 [[-45,60],[-20,64],[-18,70],[-22,76],[-32,82],[-45,83],[-58,82],[-68,78],[-73,70],[-58,64]],
 [[-81,8],[-76,11],[-70,12],[-62,10],[-52,5],[-50,1],[-44,-2],[-38,-4],[-35,-6],[-37,-11],[-39,-16],[-42,-22],[-48,-26],[-52,-32],[-58,-35],[-62,-39],[-65,-43],[-69,-52],[-75,-53],[-74,-45],[-73,-38],[-71,-30],[-70,-22],[-71,-18],[-75,-14],[-78,-8],[-81,-5],[-80,-2],[-78,1],[-77,4]],
 [[-17,15],[-17,21],[-13,28],[-6,33],[3,36],[10,37],[19,31],[25,32],[33,31],[35,27],[37,22],[39,15],[43,11],[48,12],[51,11],[48,4],[42,-1],[40,-8],[36,-15],[34,-20],[32,-26],[27,-33],[19,-35],[16,-29],[13,-23],[12,-16],[9,-6],[9,2],[5,5],[-2,5],[-8,4],[-13,8]],
 [[-10,36],[-9,43],[-4,48],[0,50],[3,51],[8,54],[9,57],[13,55],[19,55],[24,60],[21,66],[26,70],[31,70],[41,68],[55,70],[68,73],[78,73],[90,76],[105,78],[115,74],[128,73],[140,72],[155,70],[165,68],[170,60],[162,60],[155,55],[143,52],[135,48],[131,43],[127,40],[122,38],[120,34],[122,30],[118,24],[110,21],[108,15],[105,10],[103,1],[100,3],[98,8],[99,13],[95,16],[93,20],[89,22],[85,20],[80,13],[77,8],[73,15],[70,21],[67,24],[62,25],[58,22],[50,29],[48,30],[43,39],[36,36],[30,36],[26,40],[20,42],[14,42],[8,44],[3,43],[-2,36]],
 [[95,6],[100,1],[104,-2],[106,-6],[112,-8],[118,-9],[125,-9],[131,-8],[141,-9],[141,-3],[134,-1],[128,1],[120,0],[117,4],[110,2],[103,2],[98,4]],
 [[113,-22],[114,-26],[115,-32],[118,-35],[124,-33],[129,-32],[134,-33],[138,-35],[141,-38],[147,-39],[150,-37],[153,-30],[153,-25],[148,-20],[145,-15],[142,-11],[137,-12],[132,-11],[129,-15],[125,-17],[122,-18],[117,-21]],
 [[166,-46],[168,-47],[173,-42],[175,-37],[178,-38],[174,-41],[171,-44]],
 [[130,31],[132,34],[136,35],[140,36],[142,40],[141,45],[145,44],[140,41],[138,37],[135,34],[131,33]],
 [[-6,50],[-3,54],[-3,58],[-5,58],[-6,55],[-5,51]],
 [[43,-16],[47,-15],[50,-18],[48,-25],[45,-25],[43,-21]]
];
function inPoly(lon, lat, poly){
  var hit = false;
  for(var i = 0, j = poly.length - 1; i < poly.length; j = i++){
    var xi = poly[i][0], yi = poly[i][1], xj = poly[j][0], yj = poly[j][1];
    if(((yi > lat) !== (yj > lat)) && (lon < (xj - xi) * (lat - yi) / (yj - yi) + xi)) hit = !hit;
  }
  return hit;
}
function isLand(lon, lat){
  for(var i = 0; i < LAND.length; i++){ if(inPoly(lon, lat, LAND[i])) return true; }
  return false;
}
var stage = $('#stage'), cv = $('#cv'), ctx = cv.getContext('2d');
function projX(lon){ return (lon - LON0) / (LON1 - LON0); }
function projY(lat){ return (LAT1 - lat) / (LAT1 - LAT0); }
function drawMap(){
  var w = stage.clientWidth, h = stage.clientHeight;
  if(!w || !h) return;
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);
  var r = Math.max(1, w / 620);
  ctx.fillStyle = '#CFC7BE';
  ctx.beginPath();
  for(var lat = LAT1; lat >= LAT0; lat -= 1.7){
    for(var lon = LON0; lon <= LON1; lon += 1.7){
      if(!isLand(lon, lat)) continue;
      /* square dots on a grid: the energy motif's print style */
      ctx.rect(projX(lon) * w - r, projY(lat) * h - r, r * 2, r * 2);
    }
  }
  ctx.fill();
}
/* place markers; assets that sit too close to read fan out around their country,
   and the fan is rotated and nudged until every marker lands on a land dot */
D.assets.forEach(function(a){ a._x = projX(a.lon); a._y = projY(a.lat); });
var clusters = [];
D.assets.forEach(function(a){
  for(var i = 0; i < clusters.length; i++){
    var c = clusters[i], dx = a._x - c.x, dy = (a._y - c.y) * 112 / 260;
    if(Math.sqrt(dx * dx + dy * dy) < 0.03){ c.items.push(a); return; }
  }
  clusters.push({x:a._x, y:a._y, lon:a.lon, lat:a.lat, items:[a]});
});
clusters.forEach(function(c){
  c.items.forEach(function(a){
    var b = document.createElement('button');
    b.className = 'pin' + (a.kind === 'ev' ? ' ev' : '') + (a.status === 'maintenance' ? ' maint' : '');
    b.setAttribute('aria-pressed', 'false');
    b.setAttribute('aria-label', a.name + ', ' + a.place);
    b.innerHTML = '<i></i><b>' + esc(a.name) + '</b>';
    b.addEventListener('click', function(){ select(a.id); });
    stage.appendChild(b);
    a._el = b;
  });
  c.lab = document.createElement('span');
  c.lab.className = 'clab';
  c.lab.textContent = c.items[0].place.split(', ').pop();
  stage.appendChild(c.lab);
});
function layoutPins(){
  var w = stage.clientWidth, h = stage.clientHeight;
  if(!w || !h) return;
  var pxLon = w / (LON1 - LON0), pxLat = h / (LAT1 - LAT0);
  clusters.forEach(function(c){
    var n = c.items.length, R = n > 2 ? 11 : n > 1 ? 8 : 0, best = null;
    /* score every nudge and rotation that keeps all markers on land, and keep the one
       where each marker stays closest to its own asset's real location */
    for(var d = 0; d <= 40; d += 4){
      for(var da = 0; da < (d ? 12 : 1); da++){
        var sx = Math.cos(da * Math.PI / 6) * d, sy = Math.sin(da * Math.PI / 6) * d;
        for(var rot = 0; rot < (n > 1 ? 360 : 1); rot += 15){
          var pts = [], ok = true, score = 0;
          for(var i = 0; i < n; i++){
            var ang = (rot + i * 360 / n) * Math.PI / 180;
            var px = sx + Math.cos(ang) * R, py = sy + Math.sin(ang) * R;
            var lon = c.lon + px / pxLon, lat = c.lat - py / pxLat;
            if(!isLand(lon, lat)){ ok = false; break; }
            var a = c.items[i];
            score += Math.hypot((lon - a.lon) * pxLon, (lat - a.lat) * pxLat);
            pts.push([lon, lat]);
          }
          if(ok && (!best || score < best.score)) best = {pts:pts, score:score};
        }
      }
    }
    if(!best){ best = {pts:c.items.map(function(){ return [c.lon, c.lat]; }), sy:0}; }
    c.items.forEach(function(a, i){
      a._el.style.left = (projX(best.pts[i][0]) * 100) + '%';
      a._el.style.top = (projY(best.pts[i][1]) * 100) + '%';
    });
    var maxY = Math.max.apply(null, best.pts.map(function(p){ return projY(p[1]); }));
    c.lab.style.left = (projX(c.lon) * 100) + '%';
    c.lab.style.top = 'calc(' + (maxY * 100) + '% + 14px)';
  });
}
function select(id){
  var a = null;
  Array.prototype.forEach.call(document.querySelectorAll('.ops button'), function(b){ b.setAttribute('aria-pressed', b.dataset.a === id ? 'true' : 'false'); });
  D.assets.forEach(function(x){
    x._el.setAttribute('aria-pressed', x.id === id ? 'true' : 'false');
    if(x.id === id) a = x;
  });
  if(!a) return;
  var maint = a.status === 'maintenance';
  $('#panel').innerHTML =
      (PICS[a.id] ? '<img class="pic" src="' + PICS[a.id] + '" alt="' + esc(a.name) + ', ' + esc(a.place) + '">' : '')
    + '<div class="in">'
    + '<span class="badge ' + (maint ? 'behind' : 'pay') + '">' + (maint ? 'Behind on payments' : 'Paying') + '</span>'
    + '<div><h3 class="h3">' + esc(a.name) + prov('real') + '</h3>'
    + '<p class="op">' + esc(a.operator) + ' · ' + esc(a.place) + ' · ' + esc(a.type) + '</p></div>'
    + '<dl class="kv">'
    + '<div><dt class="label">Raised</dt><dd class="num s">' + money(a.raised) + '</dd></div>'
    + '<div><dt class="label">Avg yield paid</dt><dd class="num s">' + a.yield.toFixed(2) + '<span class="u">%</span></dd></div>'
    + '<div><dt class="label">Payments to date</dt><dd class="num s">' + a.payments + '</dd></div>'
    + '<div><dt class="label">Capacity</dt><dd class="num s">' + a.kw + '<span class="u">kW</span></dd></div>'
    + '<div><dt class="label">Last payment</dt><dd class="num s txt">' + esc(a.last) + (a.lastAmt ? '<span class="u">' + money(a.lastAmt) + '</span>' : '') + '</dd></div>'
    + '<div><dt class="label">Term</dt><dd class="num s txt">' + esc(a.term) + '</dd></div>'
    + '</dl>'
    + '<p class="note">' + esc(a.note) + '</p>'
    + '<a class="lnk" href="https://app.refihub.io/investments/' + a.inv + '/" target="_blank" rel="noopener">Open the asset page →</a>'
    + '</div>';
}
Array.prototype.forEach.call(document.querySelectorAll('.ops button'), function(b){ b.addEventListener('click', function(){ select(b.dataset.a); var pr = $('#panel').getBoundingClientRect(); if(pr.top < 70 || pr.top > window.innerHeight - 120) $('#panel').scrollIntoView({behavior:'smooth', block:'center'}); }); });
select('flp2');
drawMap();
layoutPins();
var rt;
window.addEventListener('resize', function(){ clearTimeout(rt); rt = setTimeout(function(){ drawMap(); layoutPins(); }, 150); });
})();
</script>
