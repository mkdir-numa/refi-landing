</script>
<script type="application/json" id="PICS" is:inline>{"flp2": "/assets/flp2.jpg", "flp": "/assets/flp.jpg", "surya": "/assets/surya.jpg", "vox": "/assets/vox.jpg", "crn": "/assets/crn.jpg", "exodos": "/assets/exodos.jpg"}</script>

<main id="top">

<section class="hero">
  <div class="bg" role="img" aria-label="Sunlight across a solar panel array"></div>
  <div class="veil"></div>
  <div class="wrap"><div class="hero-in">
    <h1>Solar and EV charging, paid in USDC.</h1>
    <p>We finance operating energy assets in Brazil, India and Singapore. Their power sales pay investors. Stake SOL with us and part of our fees funds the next ones.</p>
    <div class="row">
      <a class="btn btn-light" href="#record">See the record</a>
      <a class="btn btn-light" href="#refisol">How staking works</a>
    </div>
  </div></div>
</section>

<section class="sec stats" id="record"><div class="wrap">
  <div class="sec-head">
    <h2 class="h2">We turn electricity into USDC.</h2>
    <p class="lede">We finance energy assets that already run. When they sell power, investors get paid.</p>
  </div>
  <div class="grid6" id="grid6"></div>
  <p class="honest">Payments follow real use, so they are uneven. Two assets are behind: CRN is waiting on a contract transfer, and VOX has not paid since April.</p>
</div></section>

<section class="sec mapsec" id="map"><div class="wrap">
  <div class="sec-head">
    <h2 class="h2">Six assets. Three countries.</h2>
    <p class="lede">Click an asset to see what it raised, what it has paid, and where it stands.</p>
  </div>
  <div class="mapwrap">
    <div>
      <div class="plate"><div class="stage" id="stage"><canvas id="cv"></canvas></div></div>
      <div class="legend">
        <span><i></i>Solar</span>
        <span><i class="sq"></i>EV charging</span>
        <span><i class="am"></i>Behind on payments</span>
        <span style="color:var(--faint)">Markers grouped by country</span>
      </div>
    </div>
    <aside class="panel" id="panel" aria-live="polite"></aside>
  </div>
  <div class="ops">
    <span class="ops-l">Run by our operating partners</span>
    <button type="button" class="h-pg" data-a="flp2" aria-pressed="false" aria-label="PivotGreen, Singapore"><img src="/logos/pivotgreen.svg" alt="PivotGreen"></button>
    <button type="button" class="h-dc" data-a="surya" aria-pressed="false" aria-label="DeCharge, India"><img src="/logos/decharge.svg" alt="DeCharge"></button>
    <button type="button" class="h-ipe" data-a="exodos" aria-pressed="false" aria-label="IPE Assets, Brazil"><img src="/logos/ipe-assets.svg" alt="IPE Assets"></button>
    <button type="button" class="h-tab" data-a="crn" aria-pressed="false" aria-label="Tab Energia, Brazil"><img src="/logos/tab-energia.svg" alt="Tab Energia"></button>
    <button type="button" class="h-vox" data-a="vox" aria-pressed="false" aria-label="VOX, Rio de Janeiro"><img src="/logos/vox.svg" alt="VOX"></button>
  </div>
</div></section>

<section class="sec sol on-dark" id="refisol"><div class="wrap">
  <div class="grid">
    <div>
      <h2>Stake SOL. Fund coral reefs.</h2>
      <p class="say">refiSOL is the <b>liquid staking token from our validator</b>. 30% of our fees fund coral reefs and clean energy.<span class="prov" data-p="verify">verify</span></p>
      <div class="row2">
        <a class="btn btn-teal" href="https://mkdir-numa.github.io/reeefisol/" target="_blank" rel="noopener">Stake SOL</a>
        <a class="btn btn-light" href="https://mkdir-numa.github.io/reeefisol/#faq-fees" target="_blank" rel="noopener">Fees and risks</a>
      </div>
    </div>
    <div class="vm" id="vm"></div>
  </div>
  <p class="fine">Data: <a href="https://stakewiz.com/validator/ReFiSbuMcV8PMYcpvm9RmHDhF9HR3qyxsHZgf359NUx" target="_blank" rel="noopener" style="color:inherit;text-underline-offset:3px">Stakewiz</a> and <a href="https://www.validators.app/validators/ReFiqMfGnc7tW8WQtFFcJRPZSDAWDBnAsdoFYF2QnfR?locale=en&amp;network=mainnet" target="_blank" rel="noopener" style="color:inherit;text-underline-offset:3px">validators.app</a>, 13 Oct 2026. Rewards vary. Downtime never touches your principal. refiSOL can trade below its SOL value.</p>
</div></section>

<section class="sec reports" id="reports"><div class="wrap">
  <div class="head">
    <div class="sec-head">
      <h2 class="h2">Every asset, reported on.</h2>
      <p class="lede">Monthly operating and payment reports from each asset, and how we pick them.</p>
    </div>
    <a class="btn btn-out" href="/blog">All reports <span aria-hidden="true">→</span></a>
  </div>
  <div class="pgrid">
    {latest.map((post, i) => <PostCard post={post} index={i} />)}
  </div>
</div></section>

<section class="sec proof" id="proof"><div class="wrap">
  <div class="sec-head">
    <h2 class="h2">Building since 2021.</h2>
    <p class="lede">Our app, docs and audit are public. Check any number on this page against them.</p>
  </div>
  <div class="bk">
    <div><b>Solana Foundation</b><small>Backer <span class="prov" data-p="verify">verify</span></small></div>
    <div><b><a href="https://superteamuk.org/" target="_blank" rel="noopener">Superteam UK</a> and <a href="https://superteam.ca/" target="_blank" rel="noopener">Superteam Canada</a></b><small>Incubator and ecosystem partners <span class="prov" data-p="verify">verify</span></small></div>
    <div><b>Our own validator</b><small>refiSOL, live on Solana <span class="prov" data-p="verify">link to vote account</span></small></div>
    <div><b id="comm"></b><small>Investors, holders and <a href="https://www.coraltribe.io/" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-underline-offset:3px">Coral Tribe</a> members <span class="prov" data-p="verify">verify</span></small></div>
  </div>
  <div class="cards">
    <a href="https://app.refihub.io/energy-assets/" target="_blank" rel="noopener"><b>The app</b><small>Asset pages, monthly reports and every distribution.</small><span class="go">app.refihub.io →</span></a>
    <a href="https://refihub.gitbook.io/refi-hub/how-refi-hub-works/where-returns-come-from" target="_blank" rel="noopener"><b>Documentation</b><small>Where returns come from, how we pick assets, and the risks.</small><span class="go">refihub.gitbook.io →</span></a>
    <a href="#proof"><b>Smart-contract audit</b><small>Independent audit by Solidproof.</small><span class="go">Solidproof <span class="prov" data-p="verify">link</span></span></a>
  </div>
</div></section>

</main>

<script is:inline>
(function(){
"use strict";
var D = JSON.parse(document.getElementById('DATA').textContent);
var PICS = JSON.parse(document.getElementById('PICS').textContent);
var $ = function(s,r){ return (r||document).querySelector(s); };
var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
function prov(p){ return p ? '<span class="prov" data-p="'+p+'">'+p+'</span>' : ''; }
function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
function money(n){ return '$'+Number(n).toLocaleString('en-US',{maximumFractionDigits:0}); }

/* data-status toggle */
var pv = $('#pvBtn');
pv.addEventListener('click', function(){
  var on = document.body.classList.toggle('prov-on');
  pv.setAttribute('aria-pressed', on ? 'true' : 'false');
});

/* ---------- stat cards ---------- */
$('#grid6').innerHTML = D.stats.map(function(s){
  var shown = (s.prefix||'') + s.v.toLocaleString('en-US') + (s.suffix||'');
  return '<div class="sc">'
    + '<div class="top"><span class="lbl">'+esc(s.label)+prov(s.p)+'</span>'
    + (s.live ? '<span class="live"><b></b>LIVE</span>' : '') + '</div>'
    + '<span class="v" data-to="'+s.v+'" data-pre="'+(s.prefix||'')+'" data-suf="'+(s.suffix||'')+'">'
    + '<span class="n">'+shown+'</span>'
    + (s.unit ? '<span class="u">'+esc(s.unit)+'</span>' : '') + '</span>'
    + '<span class="sub">'+esc(s.sub)+'</span></div>';
}).join('');

function countUp(el){
  var n = el.querySelector('.n');
  var to = parseFloat(el.dataset.to), pre = el.dataset.pre, suf = el.dataset.suf;
  var dec = (to % 1 !== 0) ? 1 : 0, t0 = performance.now(), dur = 900;
  function step(now){
    var k = Math.min(1, (now - t0) / dur), eased = 1 - Math.pow(1 - k, 3), cur = to * eased;
    n.textContent = pre + (dec ? cur.toFixed(dec) : Math.round(cur).toLocaleString('en-US')) + suf;
    if(k < 1) requestAnimationFrame(step);
    else n.textContent = pre + (dec ? to.toFixed(dec) : to.toLocaleString('en-US')) + suf;
  }
  requestAnimationFrame(step);
}
/* cards reveal three at a time: each row of three waits until it scrolls into view */
if(!reduced && 'IntersectionObserver' in window){
  var cards = Array.prototype.slice.call(document.querySelectorAll('#grid6 .sc')), rows = [];
  cards.forEach(function(c, i){ c.classList.add('hide'); (rows[Math.floor(i / 3)] = rows[Math.floor(i / 3)] || []).push(c); });
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting) return;
      io.unobserve(e.target);
      rows[e.target.dataset.row].forEach(function(c, j){
        c.style.transitionDelay = (j * 90) + 'ms';
        c.classList.remove('hide');
        setTimeout(function(){ countUp(c.querySelector('.v')); }, j * 90);
      });
    });
  }, {threshold:.35, rootMargin:'0px 0px -8% 0px'});
  rows.forEach(function(r, i){ r[0].dataset.row = i; io.observe(r[0]); });
}

/* ---------- world map ---------- */
var LON0 = -110, LON1 = 150, LAT0 = -50, LAT1 = 62;
var LAND = [
 [[-168,66],[-160,71],[-140,70],[-125,70],[-110,68],[-95,69],[-82,73],[-70,68],[-64,60],[-55,52],[-62,47],[-67,45],[-70,42],[-74,39],[-78,34],[-81,28],[-80,25],[-84,22],[-88,21],[-91,17],[-84,10],[-78,8],[-83,14],[-94,16],[-97,25],[-105,21],[-112,26],[-117,33],[-122,38],[-124,45],[-124,49],[-131,54],[-141,60],[-152,59],[-163,59]],
 [[-45,60],[-20,64],[-18,70],[-22,76],[-32,82],[-45,83],[-58,82],[-68,78],[-73,70],[-58,64]],
 [[-81,8],[-76,11],[-70,12],[-62,10],[-52,5],[-50,1],[-44,-2],[-38,-4],[-35,-6],[-37,-11],[-39,-16],[-42,-22],[-48,-26],[-52,-32],[-58,-35],[-62,-39],[-65,-43],[-69,-52],[-75,-53],[-74,-45],[-73,-38],[-71,-30],[-70,-22],[-71,-18],[-75,-14],[-78,-8],[-81,-5],[-80,-2],[-78,1],[-77,4]],
 [[-17,15],[-17,21],[-13,28],[-6,33],[3,36],[10,37],[19,31],[25,32],[33,31],[35,27],[37,22],[39,15],[43,11],[48,12],[51,11],[48,4],[42,-1],[40,-8],[36,-15],[34,-20],[32,-26],[27,-33],[19,-35],[16,-29],[13,-23],[12,-16],[9,-6],[9,2],[5,5],[-2,5],[-8,4],[-13,8]],
 [[-10,36],[-9,43],[-4,48],[0,50],[3,51],[8,54],[9,57],[13,55],[19,55],[24,60],[21,66],[26,70],[31,70],[41,68],[55,70],[68,73],[78,73],[90,76],[105,78],[115,74],[128,73],[140,72],[155,70],[165,68],[170,60],[162,60],[155,55],[143,52],[135,48],[131,43],[127,40],[122,38],[120,34],[122,30],[118,24],[110,21],[108,15],[105,10],[103,1],[100,3],[98,8],[99,13],[95,16],[93,20],[89,22],[85,20],[80,13],[77,8],[73,15],[70,21],[67,24],[62,25],[58,22],[50,29],[48,30],[43,39],[36,36],[30,36],[26,40],[20,42],[14,42],[8,44],[3,43],[-2,36]],
 [[95,6],[100,1],[104,-2],[106,-6],[112,-8],[118,-9],[125,-9],[131,-8],[141,-9],[141,-3],[134,-1],[128,1],[120,0],[117,4],[110,2],[103,2],[98,4]],
 [[113,-22],[114,-26],[115,-32],[118,-35],[124,-33],[129,-32],[134,-33],[138,-35],[141,-38],[147,-39],[150,-37],[153,-30],[153,-25],[148,-20],[145,-15],[142,-11],[137,-12],[132,-11],[129,-15],[125,-17],[122,-18],[117,-21]],
 [[166,-46],[168,-47],[173,-42],[175,-37],[178,-38],[174,-41],[171,-44]],
 [[130,31],[132,34],[136,35],[140,36],[142,40],[141,45],[145,44],[140,41],[138,37],[135,34],[131,33]],
 [[-6,50],[-3,54],[-3,58],[-5,58],[-6,55],[-5,51]],
 [[43,-16],[47,-15],[50,-18],[48,-25],[45,-25],[43,-21]]
];
function inPoly(lon, lat, poly){
  var hit = false;
  for(var i = 0, j = poly.length - 1; i < poly.length; j = i++){
    var xi = poly[i][0], yi = poly[i][1], xj = poly[j][0], yj = poly[j][1];
    if(((yi > lat) !== (yj > lat)) && (lon < (xj - xi) * (lat - yi) / (yj - yi) + xi)) hit = !hit;
  }
  return hit;
}
function isLand(lon, lat){
  for(var i = 0; i < LAND.length; i++){ if(inPoly(lon, lat, LAND[i])) return true; }
  return false;
}
var stage = $('#stage'), cv = $('#cv'), ctx = cv.getContext('2d');
function projX(lon){ return (lon - LON0) / (LON1 - LON0); }
function projY(lat){ return (LAT1 - lat) / (LAT1 - LAT0); }
function drawMap(){
  var w = stage.clientWidth, h = stage.clientHeight;
  if(!w || !h) return;
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);
  var r = Math.max(1, w / 560);
  ctx.fillStyle = '#CFC7BE';
  for(var lat = LAT1; lat >= LAT0; lat -= 1.7){
    for(var lon = LON0; lon <= LON1; lon += 1.7){
      if(!isLand(lon, lat)) continue;
      ctx.beginPath();
      ctx.arc(projX(lon) * w, projY(lat) * h, r, 0, 6.2832);
      ctx.fill();
    }
  }
}
/* place markers; assets that sit too close to read fan out around their country,
   and the fan is rotated and nudged until every marker lands on a land dot */
D.assets.forEach(function(a){ a._x = projX(a.lon); a._y = projY(a.lat); });
var clusters = [];
D.assets.forEach(function(a){
  for(var i = 0; i < clusters.length; i++){
    var c = clusters[i], dx = a._x - c.x, dy = (a._y - c.y) * 112 / 260;
    if(Math.sqrt(dx * dx + dy * dy) < 0.03){ c.items.push(a); return; }
  }
  clusters.push({x:a._x, y:a._y, lon:a.lon, lat:a.lat, items:[a]});
});
clusters.forEach(function(c){
  c.items.forEach(function(a){
    var b = document.createElement('button');
    b.className = 'pin' + (a.kind === 'ev' ? ' ev' : '') + (a.status === 'maintenance' ? ' maint' : '');
    b.setAttribute('aria-pressed', 'false');
    b.setAttribute('aria-label', a.name + ', ' + a.place);
    b.innerHTML = '<i></i><b>' + esc(a.name) + '</b>';
    b.addEventListener('click', function(){ select(a.id); });
    stage.appendChild(b);
    a._el = b;
  });
  c.lab = document.createElement('span');
  c.lab.className = 'clab';
  c.lab.textContent = c.items[0].place.split(', ').pop();
  stage.appendChild(c.lab);
});
function layoutPins(){
  var w = stage.clientWidth, h = stage.clientHeight;
  if(!w || !h) return;
  var pxLon = w / (LON1 - LON0), pxLat = h / (LAT1 - LAT0);
  clusters.forEach(function(c){
    var n = c.items.length, R = n > 2 ? 11 : n > 1 ? 8 : 0, best = null;
    /* score every nudge and rotation that keeps all markers on land, and keep the one
       where each marker stays closest to its own asset's real location */
    for(var d = 0; d <= 40; d += 4){
      for(var da = 0; da < (d ? 12 : 1); da++){
        var sx = Math.cos(da * Math.PI / 6) * d, sy = Math.sin(da * Math.PI / 6) * d;
        for(var rot = 0; rot < (n > 1 ? 360 : 1); rot += 15){
          var pts = [], ok = true, score = 0;
          for(var i = 0; i < n; i++){
            var ang = (rot + i * 360 / n) * Math.PI / 180;
            var px = sx + Math.cos(ang) * R, py = sy + Math.sin(ang) * R;
            var lon = c.lon + px / pxLon, lat = c.lat - py / pxLat;
            if(!isLand(lon, lat)){ ok = false; break; }
            var a = c.items[i];
            score += Math.hypot((lon - a.lon) * pxLon, (lat - a.lat) * pxLat);
            pts.push([lon, lat]);
          }
          if(ok && (!best || score < best.score)) best = {pts:pts, score:score};
        }
      }
    }
    if(!best){ best = {pts:c.items.map(function(){ return [c.lon, c.lat]; }), sy:0}; }
    c.items.forEach(function(a, i){
      a._el.style.left = (projX(best.pts[i][0]) * 100) + '%';
      a._el.style.top = (projY(best.pts[i][1]) * 100) + '%';
    });
    var maxY = Math.max.apply(null, best.pts.map(function(p){ return projY(p[1]); }));
    c.lab.style.left = (projX(c.lon) * 100) + '%';
    c.lab.style.top = 'calc(' + (maxY * 100) + '% + 14px)';
  });
}
function select(id){
  var a = null;
  Array.prototype.forEach.call(document.querySelectorAll('.ops button'), function(b){ b.setAttribute('aria-pressed', b.dataset.a === id ? 'true' : 'false'); });
  D.assets.forEach(function(x){
    x._el.setAttribute('aria-pressed', x.id === id ? 'true' : 'false');
    if(x.id === id) a = x;
  });
  if(!a) return;
  var maint = a.status === 'maintenance';
  $('#panel').innerHTML =
      (PICS[a.id] ? '<img class="pic" src="' + PICS[a.id] + '" alt="' + esc(a.name) + ', ' + esc(a.place) + '">' : '')
    + '<div class="ph">'
    + '<span class="badge' + (maint ? ' maint' : '') + '"><i></i>' + (maint ? 'Behind on payments' : 'Paying') + '</span>'
    + '<span class="nm">' + esc(a.name) + prov('real') + '</span>'
    + '<span class="op">' + esc(a.operator) + ' · ' + esc(a.place) + ' · ' + esc(a.type) + '</span>'
    + '</div>'
    + '<dl class="kv">'
    + '<div><dt>Raised</dt><dd>' + money(a.raised) + '</dd></div>'
    + '<div><dt>Avg yield paid</dt><dd>' + a.yield.toFixed(2) + '<small>%</small></dd></div>'
    + '<div><dt>Payments to date</dt><dd>' + a.payments + '</dd></div>'
    + '<div><dt>Capacity</dt><dd>' + a.kw + '<small>kW</small></dd></div>'
    + '<div><dt>Last payment</dt><dd style="font-size:16px">' + esc(a.last) + (a.lastAmt ? '<small>' + money(a.lastAmt) + '</small>' : '') + '</dd></div>'
    + '<div><dt>Term</dt><dd style="font-size:16px">' + esc(a.term) + '</dd></div>'
    + '</dl>'
    + '<p class="note">' + esc(a.note) + '</p>'
    + '<a class="go" href="https://app.refihub.io/investments/' + a.inv + '/" target="_blank" rel="noopener">Open the asset page →</a>';
}
Array.prototype.forEach.call(document.querySelectorAll('.ops button'), function(b){ b.addEventListener('click', function(){ select(b.dataset.a); var pr = $('#panel').getBoundingClientRect(); if(pr.top < 70 || pr.top > window.innerHeight - 120) $('#panel').scrollIntoView({behavior:'smooth', block:'center'}); }); });
select('flp2');
drawMap();
layoutPins();
var rt;
window.addEventListener('resize', function(){ clearTimeout(rt); rt = setTimeout(function(){ drawMap(); layoutPins(); }, 150); });

/* ---------- validator metrics ---------- */
var V = D.validator;
$('#vm').innerHTML = ['sol','uptime','fees','value'].map(function(k){
  var m = V[k];
  return '<div><span class="v">' + esc(m.v) + '<span class="u">' + esc(m.u) + '</span></span>'
       + '<span class="l">' + esc(m.l) + prov(m.p) + '</span></div>';
}).join('');

/* ---------- community + subscribe ---------- */
$('#comm').textContent = 'Over ' + D.community.v + ' members';
})();
</script>
<Reveal />
</Base>
