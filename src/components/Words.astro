---
// Splits a headline into word spans so it can rise in word by word.
interface Props { text: string; as?: 'h1' | 'h2'; class?: string }
const { text, as: Tag = 'h1', class: cls } = Astro.props;
const words = text.split(/\s+/);
---
<Tag class:list={[cls, 'words']} aria-label={text}>{words.map((w, i) => <><span class="w" aria-hidden="true" style={`--w:${i}`}>{w}</span>{i < words.length - 1 && ' '}</>)}</Tag>
