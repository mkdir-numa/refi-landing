---
import Logo from './Logo.astro';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const onBlog = Astro.url.pathname.startsWith(u('/blog'));
import { u } from '../lib/url';

const STAKE = 'https://refihub-stake.netlify.app/';
const APP = 'https://app.refihub.io/';

/* "How it works" menu, same two groups as refihub.io. Line icons drawn on a 24px grid. */
const ICON = {
  sun: '<path d="M4 17h16M7 17a5 5 0 0 1 10 0M12 7V5M6.3 9.3 4.9 7.9M17.7 9.3l1.4-1.4M3 13h2M19 13h2"/>',
  book: '<path d="M12 6c-2-1.3-4.7-1.6-8-1v13c3.3-.6 6-.3 8 1 2-1.3 4.7-1.6 8-1V5c-3.3-.6-6-.3-8 1zM12 6v13"/>',
  shield: '<path d="M12 3 5 6v5c0 4.4 3 8.3 7 10 4-1.7 7-5.6 7-10V6l-7-3z"/><path d="m9 12 2 2 4-4"/>',
  grid: '<path d="M7 7h.01M12 7h.01M17 7h.01M7 12h.01M12 12h.01M17 12h.01M7 17h.01M12 17h.01M17 17h.01"/>',
  bars: '<path d="M4 20h16M7 20v-6M12 20V9M17 20V5"/>',
  plug: '<path d="M9 3v4M15 3v4M7 7h10v4a5 5 0 0 1-10 0V7zM12 16v5"/>',
};
const MENU = [
  { head: 'Resources', items: [
    { icon: 'sun', title: 'How it works', text: 'How solar assets generate revenue and pay investors.', href: u('/blog/how-solar-assets-generate-revenue-for-investors') },
    { icon: 'book', title: 'Investor guide', text: 'Everything you need to know before your first investment.', href: u('/blog/investor-guide') },
    { icon: 'shield', title: 'Due diligence framework', text: 'How we check energy assets before they are listed.', href: u('/blog/rebusiness-due-diligence-framework') },
  ] },
  { head: 'Asset updates', items: [
    { icon: 'grid', title: 'Exodos annual review', text: 'A full year of solar output and payments.', href: u('/blog/exodos-ipe-annual-asset-performance-review') },
    { icon: 'bars', title: 'Surya distribution report', text: 'Monthly revenue and distribution data from DeCharge.', href: u('/blog/project-surya-second-month-operating-distribution-report') },
    { icon: 'plug', title: 'CRN build and cashflow', text: 'Construction, grid connection and the first payments.', href: u('/blog/crn-build-and-cashflow-update') },
  ] },
] as const;
---
<header class="nav" id="nav"><div class="wrap">
  <a class="brand" href={u('/')} aria-label="ReFi Hub home"><Logo /></a>
  <nav class="nav-links" id="navLinks" aria-label="Main">
    <ul>
      <li><a href="https://app.refihub.io/energy-assets/" target="_blank" rel="noopener">Energy assets</a></li>
      <li><a href={u('/#refisol')}>Stake Solana</a></li>
      <li class="has-menu">
        <button type="button" class="menu-toggle" id="howBtn" aria-expanded="false" aria-controls="howMenu">How it works<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>
        <div class="mega" id="howMenu">
          {MENU.map((g) => (
            <div class="mega-col">
              <p class="label">{g.head}</p>
              {g.items.map((it) => (
                <a class="mega-item" href={it.href}>
                  <span class="mega-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON[it.icon]} /></span>
                  <span><b>{it.title}</b><small>{it.text}</small></span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </li>
      <li><a href={u('/blog')} aria-current={onBlog ? 'page' : undefined}>Blog</a></li>
    </ul>
    <div class="nav-ctas-sheet">
      <a class="btn btn-ghost" href={APP} target="_blank" rel="noopener">Access platform</a>
    </div>
  </nav>
  <span class="sp"></span>
  {home && <button class="pv" id="pvBtn" aria-pressed="false" title="Show which numbers are real, to verify, or mock"><i></i><span>Data status</span></button>}
  <a class="btn btn-ghost nav-app" href={APP} target="_blank" rel="noopener">Access platform</a>
  <a class="btn btn-stake" href={STAKE} target="_blank" rel="noopener">Stake Solana</a>
  <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="navLinks">Menu</button>
</div></header>
<script>
  // Hairline under the header once the page scrolls, the "How it works" menu, and the sheet on phones.
  const nav = document.getElementById('nav')!;
  const btn = document.getElementById('menuBtn')!;
  const how = document.getElementById('howBtn')!;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    nav.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.textContent = open ? 'Close' : 'Menu';
  };
  const setHow = (open: boolean) => how.setAttribute('aria-expanded', open ? 'true' : 'false');

  btn.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
  // on a mouse, hovering opens it too; a click right after that hover keeps it open instead of closing it
  let hoveredAt = 0;
  how.addEventListener('click', () => {
    if (Date.now() - hoveredAt < 600) return;
    setHow(how.getAttribute('aria-expanded') !== 'true');
  });
  const item = how.parentElement!;
  item.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hoveredAt = Date.now(); setHow(true); } });
  item.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') setHow(false); });
  item.addEventListener('focusout', (e) => { if (!item.contains(e.relatedTarget as Node)) setHow(false); });

  document.querySelectorAll('#navLinks a').forEach((a) => a.addEventListener('click', () => { setOpen(false); setHow(false); }));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setOpen(false); setHow(false); } });
</script>
